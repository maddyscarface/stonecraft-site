# ───────── Site ─────────
NEXT_PUBLIC_SITE_URL=https://stonecraftpros.com
# Phone numbers: leave EMPTY until a real line exists. While empty, every phone number,
# tap-to-call/SMS link and schema "telephone" is hidden. Placeholder patterns are rejected.
NEXT_PUBLIC_PHONE_BOSTON=
NEXT_PUBLIC_PHONE_BOSTON_DISPLAY=
NEXT_PUBLIC_PHONE_FL=
NEXT_PUBLIC_PHONE_FL_DISPLAY=
NEXT_PUBLIC_CONTACT_EMAIL=info@stonecraftpros.com
# pre-launch until franchise counsel clears Florida (docs/15 G1)
MARKET_FL_STATUS=pre-launch
# granted (US opt-out model) | denied (opt-in) — counsel decision
NEXT_PUBLIC_CONSENT_DEFAULT=granted

# ───────── Admin ─────────
ADMIN_TOKEN=                      # 32+ random chars
CRM_WEBHOOK_SECRET=               # 32+ random chars

# ───────── Storage ─────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required in production: without Upstash, /api/leads returns 503 instead of keeping leads in memory.
# LOCAL TESTING ONLY: allow `next start` to accept leads into process memory. Never set in Vercel.
LEAD_ALLOW_MEMORY_STORE=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # server only
SUPABASE_PHOTO_BUCKET=assessment-photos
ALLOW_LOCAL_UPLOADS=false         # true only for local/sandbox testing

# ───────── GoHighLevel ─────────
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID_BOSTON=
GHL_LOCATION_ID_FL=
# GHL pipelines + stages (Build 04 §3). Two pipelines per market sub-team; property managers use COMMERCIAL.
# Teams: GHL_BOSTON = Boston / Greater Boston, GHL_FL = Palm Beach / Broward. Each has its own owner + calendars.
GHL_BOSTON_PIPELINE_RESIDENTIAL=
GHL_BOSTON_PIPELINE_COMMERCIAL=
GHL_BOSTON_TEAM_USER_ID=
GHL_BOSTON_CALENDAR_RESIDENTIAL=
GHL_BOSTON_CALENDAR_COMMERCIAL=
GHL_BOSTON_STAGE_RES_NEW=
GHL_BOSTON_STAGE_RES_PHOTOS_REQUESTED=
GHL_BOSTON_STAGE_RES_PHOTOS_RECEIVED=
GHL_BOSTON_STAGE_RES_QUALIFIED=
GHL_BOSTON_STAGE_RES_ESTIMATE_VISIT=
GHL_BOSTON_STAGE_RES_PROPOSAL=
GHL_BOSTON_STAGE_RES_WON=
GHL_BOSTON_STAGE_RES_LOST=
GHL_BOSTON_STAGE_RES_SCHEDULED=
GHL_BOSTON_STAGE_RES_COMPLETED=
GHL_BOSTON_STAGE_COM_INBOUND_OUTREACH=
GHL_BOSTON_STAGE_COM_FACILITY_QUALIFIED=
GHL_BOSTON_STAGE_COM_SITE_WALKTHROUGH=
GHL_BOSTON_STAGE_COM_SCOPE=
GHL_BOSTON_STAGE_COM_BID_PROPOSAL=
GHL_BOSTON_STAGE_COM_AWARDED=
GHL_BOSTON_STAGE_COM_SCHEDULED=
GHL_BOSTON_STAGE_COM_CLOSEOUT=
GHL_BOSTON_STAGE_COM_RECURRING_PROGRAM=
GHL_FL_PIPELINE_RESIDENTIAL=
GHL_FL_PIPELINE_COMMERCIAL=
GHL_FL_TEAM_USER_ID=
GHL_FL_CALENDAR_RESIDENTIAL=
GHL_FL_CALENDAR_COMMERCIAL=
GHL_FL_STAGE_RES_NEW=
GHL_FL_STAGE_RES_PHOTOS_REQUESTED=
GHL_FL_STAGE_RES_PHOTOS_RECEIVED=
GHL_FL_STAGE_RES_QUALIFIED=
GHL_FL_STAGE_RES_ESTIMATE_VISIT=
GHL_FL_STAGE_RES_PROPOSAL=
GHL_FL_STAGE_RES_WON=
GHL_FL_STAGE_RES_LOST=
GHL_FL_STAGE_RES_SCHEDULED=
GHL_FL_STAGE_RES_COMPLETED=
GHL_FL_STAGE_COM_INBOUND_OUTREACH=
GHL_FL_STAGE_COM_FACILITY_QUALIFIED=
GHL_FL_STAGE_COM_SITE_WALKTHROUGH=
GHL_FL_STAGE_COM_SCOPE=
GHL_FL_STAGE_COM_BID_PROPOSAL=
GHL_FL_STAGE_COM_AWARDED=
GHL_FL_STAGE_COM_SCHEDULED=
GHL_FL_STAGE_COM_CLOSEOUT=
GHL_FL_STAGE_COM_RECURRING_PROGRAM=
# Optional: JSON map of custom-field keys → GHL field ids, e.g. {"sc_lead_score":"abc123"}
GHL_CUSTOM_FIELD_IDS=
# Follow-up automation: one GHL workflow id per hook per market (leave blank to skip a hook).
# Hooks: NEW_LEAD, PHOTOS_MISSING, HOT_LEAD, NURTURE, RENTER_LANDLORD, PROPERTY_MANAGER, COMMERCIAL, PRELAUNCH_WAITLIST, OUT_OF_AREA, ESTIMATE_FOLLOW_UP, REACTIVATION (last two are stage-triggered in GHL)
GHL_BOSTON_WORKFLOW_NEW_LEAD=
GHL_BOSTON_WORKFLOW_PHOTOS_MISSING=
GHL_BOSTON_WORKFLOW_HOT_LEAD=
GHL_BOSTON_WORKFLOW_NURTURE=
GHL_BOSTON_WORKFLOW_RENTER_LANDLORD=
GHL_BOSTON_WORKFLOW_PROPERTY_MANAGER=
GHL_BOSTON_WORKFLOW_COMMERCIAL=
GHL_BOSTON_WORKFLOW_OUT_OF_AREA=
GHL_BOSTON_WORKFLOW_ESTIMATE_FOLLOW_UP=
GHL_BOSTON_WORKFLOW_REACTIVATION=
GHL_FL_WORKFLOW_NEW_LEAD=
GHL_FL_WORKFLOW_PRELAUNCH_WAITLIST=
GHL_FL_WORKFLOW_PHOTOS_MISSING=
GHL_FL_WORKFLOW_HOT_LEAD=
GHL_FL_WORKFLOW_NURTURE=
GHL_FL_WORKFLOW_COMMERCIAL=
GHL_FL_WORKFLOW_ESTIMATE_FOLLOW_UP=
GHL_FL_WORKFLOW_REACTIVATION=
# Set "false" to silence the [ghl:dry-run] log lines when no token is configured
GHL_LOG_DRY_RUN=

# ───────── Email (Resend) ─────────
RESEND_API_KEY=
NOTIFY_FROM="StoneCraft <info@stonecraftpros.com>"
NOTIFY_TO_BOSTON=
NOTIFY_TO_FL=
NOTIFY_TO=

# ───────── Tracking ─────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=                    # MUST equal NEXT_PUBLIC_META_PIXEL_ID so browser + CAPI events deduplicate
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=             # staging only
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Direct gtag.js (used only when NEXT_PUBLIC_GTM_ID is empty — otherwise configure these inside GTM)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=                 # AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=         # conversion label for website leads
NEXT_PUBLIC_LEAD_VALUE=                    # optional expected lead value in USD
# Google Ads offline conversions (won/paid revenue from GHL). Without these, conversions queue for CSV import (/api/admin/export).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTIONS=             # JSON {"job_won":"123","purchase":"456","qualified_lead":"789"}
GOOGLE_ADS_API_VERSION=                    # default v21 — verify current version

# ───────── Intent data: DataMoon / AudienceLab (OFF by default) ─────────
INTENT_PROVIDER=                           # datamoon | audiencelab
INTENT_WEBHOOK_SECRET=                     # provider sends it as x-intent-secret to /api/intent/webhook
NEXT_PUBLIC_INTENT_ENABLED=false           # pixel kill switch
NEXT_PUBLIC_INTENT_PIXEL_SRC=              # provider script URL; loads only with ad consent, never with GPC

# ───────── Staging ─────────
SITE_NOINDEX=                              # "true" forces noindex; Vercel preview deployments are noindex automatically

# ───────── Anti-spam (optional) ─────────
TURNSTILE_SECRET_KEY=

# ───────── Room scan beta (optional, admin only) ─────────
ROOM_SCAN_ENABLED=false
ANTHROPIC_API_KEY=
ROOM_SCAN_MODEL=claude-sonnet-5-5

# --- OpenAI Ads (ChatGPT ads) — Ads Manager → Conversions tab ---
# Browser pixel (public). Loads only after advertising consent; GPC always blocks it.
NEXT_PUBLIC_OPENAI_PIXEL_ID=
# Set "true" while testing to log pixel activity in the browser console.
NEXT_PUBLIC_OPENAI_PIXEL_DEBUG=
# Conversions API (server only, never expose). Must use the SAME pixel id as above for dedup.
OPENAI_ADS_PIXEL_ID=
OPENAI_ADS_API_KEY=
# "true" = OpenAI validates events but does not record them. Turn off at launch.
OPENAI_ADS_VALIDATE_ONLY=true
OPENAI_ADS_INTEGRATION_SOURCE=

# --- Team lead brief email: uses existing RESEND_API_KEY, NOTIFY_FROM, NOTIFY_TO_BOSTON / NOTIFY_TO (comma-separated OK) ---

# --- Content-Security-Policy ---
# CSP ships as Report-Only (allows OpenAI pixel bzrcdn/bzr.openai.com, GTM/GA4, Meta, Turnstile, GHL, Supabase).
# Check the browser console for violations after GTM is live, then set "true" to enforce.
CSP_ENFORCE=
